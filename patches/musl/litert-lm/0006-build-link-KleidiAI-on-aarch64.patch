From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ian MacDonald <ian@netstatz.com>
Date: Sat, 31 Oct 2026 02:23:48 -0400
Subject: [PATCH 6/6] build: link KleidiAI on aarch64

On aarch64 TFLite builds XNNPACK with KleidiAI and puts it in its own
archive (kleidiai/libkleidiai.a). The committed
tflite_litert_lm_target_map.cmake was generated on an x86_64 host and does
not name it, so libLiteRt.so fails to link (undefined reference to
kai_run_lhs_quant_pack_qai8dxp_f32 and the other kai_* entry points).
Append the archive to the map when the target processor is aarch64.

Assisted-by: claude:opus-5.5
---
 cmake/packages/tflite/tflite_litert_lm_target_map.cmake | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/cmake/packages/tflite/tflite_litert_lm_target_map.cmake b/cmake/packages/tflite/tflite_litert_lm_target_map.cmake
index 422e39dd..abfc56b2 100644
--- a/cmake/packages/tflite/tflite_litert_lm_target_map.cmake
+++ b/cmake/packages/tflite/tflite_litert_lm_target_map.cmake
@@ -50,3 +50,11 @@ set(LITERTLM_TFLITE_TARGET_MAP
     "tflite::benchmark_result_proto=${LITERTLM_TFLITE_BUILD_DIR}/tools/benchmark/proto/libbenchmark_result_proto${CMAKE_STATIC_LIBRARY_SUFFIX}"
     CACHE INTERNAL "Mapping of tflite targets"
 )
+
+# On aarch64 XNNPACK's microkernels call KleidiAI (kai_*), and TFLite builds it as its own archive,
+# which this map (generated on an x86_64 host) does not name; libLiteRt.so and litert_lm_main then
+# fail to link (undefined reference to kai_run_lhs_quant_pack_qai8dxp_f32).
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64|ARM64)$")
+    list(APPEND LITERTLM_TFLITE_TARGET_MAP
+        "tflite::kleidiai=${LITERTLM_TFLITE_BUILD_DIR}/kleidiai/libkleidiai${CMAKE_STATIC_LIBRARY_SUFFIX}")
+endif()
