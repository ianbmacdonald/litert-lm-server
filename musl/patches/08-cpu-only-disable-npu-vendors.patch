diff --git a/cmake/packages/litert/litert_patcher.cmake b/cmake/packages/litert/litert_patcher.cmake
index 4e693b4..290c2cb 100644
--- a/cmake/packages/litert/litert_patcher.cmake
+++ b/cmake/packages/litert/litert_patcher.cmake
@@ -256,4 +256,13 @@ foreach(_tensor_cmakelist IN LISTS _tensor_example_cmakelists)
     endif()
 endforeach()
 
+# CPU-only build (litert-lm-server/musl): with LITERT_ENABLE_NPU off, do not configure the vendor
+# dispatch tree at all. vendors/CMakeLists.txt otherwise downloads the Qualcomm QAIRT, Samsung
+# LiteCore and MediaTek NeuroPilot SDK headers and force-enables Qualcomm/Samsung when they exist.
+patch_file_content("${LITERTLM_LITERT_SRC_DIR}/CMakeLists.txt"
+    "\nadd_subdirectory(vendors)\n"
+    "\nif(LITERT_ENABLE_NPU)\n  add_subdirectory(vendors)\nendif()\n"
+    FALSE
+)
+
 message(STATUS "[LiteRTLM] Patching Phase Complete.")
